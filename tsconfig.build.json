{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "experimentalDecorators": true,
    "noCheck": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./",
    "sourceMap": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "doc_build",
    "packages",
    "src/**/*.test.ts"
  ],
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts", "src/**/*.js"]
}
