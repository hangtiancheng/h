{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "experimentalDecorators": true,
    "noCheck": true,
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "outDir": "./dist",
    "rootDir": "./",
    "sourceMap": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "chunks/**/*.test.ts"
  ],
  "extends": "./tsconfig.json",
  "include": [
    "chunks/**/*.ts",
    "chunks/**/*.js"
  ]
}
