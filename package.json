{
  "name": "homepage",
  "version": "1.0.0",
  "description": "homepage",
  "private": true,
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "prepare": "husky",
    "lint": "eslint --fix ./src",
    "format": "prettier -w ./",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "git:commit": "git add -A && git commit -m \"feat: Introduce new features\"",
    "git:commit:ci": "git add -A && git commit -m \"ci: Deploy homepage\"",
    "git:push": "pnpm git:commit && git push origin main",
    "git:push:ci": "pnpm git:commit:ci && git push origin main",
    "pwa": "pnpm dlx @vite-pwa/assets-generator --preset minimal docs/public/favicon.svg"
  },
  "keywords": [
    "homepage",
    "algorithm"
  ],
  "author": "https://github.com/hangtiancheng",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.5",
    "concurrently": "^9.2.4",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "mermaid": "^11.16.0",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitepress": "1.6.4",
    "vue": "^3.5.40"
  },
  "lint-staged": {
    "*.{json,jsonc,js,cjs,mjs,jsx,ts,cts,mts,tsx,html,vue,css,scss,md,mdx}": [
      "pnpm format"
    ]
  },
  "type": "module"
}
