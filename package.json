{
  "name": "homepage",
  "version": "0.0.0",
  "private": true,
  "description": "homepage",
  "keywords": [
    "@swifty.js",
    "hangtiancheng",
    "homepage"
  ],
  "license": "MIT",
  "author": "https://github.com/hangtiancheng",
  "type": "module",
  "scripts": {
    "dev": "DOCS_PASSWORD=pass vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "prepare": "husky",
    "lint": "eslint --fix ./",
    "format": "prettier -w ./ --experimental-cli",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "git:commit": "git add -A && git commit -m \"feat: Introduce new features\"",
    "git:push": "pnpm git:commit && git push origin main",
    "pwa": "pnpm dlx @vite-pwa/assets-generator --preset minimal public/favicon.svg"
  },
  "dependencies": {
    "@lark.js/docs": "^0.0.26",
    "@swifty.js/anti-copy": "latest",
    "vitepress": "1.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swifty.js/docs": "^0.0.15",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{json,jsonc,js,cjs,mjs,jsx,ts,cts,mts,tsx,html,vue,css,scss,md,mdx}": [
      "pnpm format"
    ]
  },
  "packageManager": "pnpm@10.33.0"
}
