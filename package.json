{
  "name": "homepage",
  "version": "0.0.0",
  "private": true,
  "description": "homepage",
  "keywords": [
    "@swifty.js",
    "hangtiancheng",
    "homepage"
  ],
  "license": "MIT",
  "author": "https://github.com/hangtiancheng",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "dev:lark": "DOCS_PASSWORD=pass vite --mode=lark",
    "build:lark": "vite build --mode=lark",
    "preview:lark": "vite preview --mode=lark",
    "dev:swifty": "DOCS_PASSWORD=pass vite --mode=swifty",
    "build:swifty": "vite build --mode=swifty",
    "preview:swifty": "vite preview --mode=swifty",
    "prepare": "husky && pnpm --filter @swifty.js/anti-copy build",
    "lint": "eslint --fix ./src",
    "format": "prettier -w ./ --experimental-cli",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "git:commit": "git add -A && git commit -m \"feat: Introduce new features\"",
    "git:push": "pnpm git:commit && git push origin main",
    "pwa": "pnpm dlx @vite-pwa/assets-generator --preset minimal public/favicon.svg"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lark.js/docs": "catalog:",
    "@swifty.js/anti-copy": "catalog:",
    "@swifty.js/docs": "catalog:",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "concurrently": "^9.2.4",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "mermaid": "^11.16.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitepress": "1.6.4",
    "vitest": "^4.1.10",
    "vue": "^3.5.41"
  },
  "lint-staged": {
    "*.{json,jsonc,js,cjs,mjs,jsx,ts,cts,mts,tsx,html,vue,css,scss,md,mdx}": [
      "pnpm format"
    ]
  },
  "packageManager": "pnpm@10.33.0"
}
