{
  "name": "@swifty.js/anti-copy",
  "version": "0.0.1",
  "private": true,
  "description": "Copy-protection SDK for browsers",
  "license": "MIT",
  "author": "https://github.com/hangtiancheng",
  "repository": {
    "type": "git",
    "url": "https://github.com/hangtiancheng/h.git",
    "directory": "packages/anti-copy"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./vitepress": {
      "types": "./src/vitepress/index.ts",
      "default": "./src/vitepress/index.ts"
    },
    "./swifty-docs": {
      "types": "./src/swifty-docs/index.ts",
      "default": "./src/swifty-docs/index.ts"
    },
    "./rspress": {
      "types": "./src/rspress/index.ts",
      "default": "./src/rspress/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "format": "oxfmt --write ./",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "happy-dom": "^20.11.1",
    "oxfmt": "^0.61.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@rspress/core": ">=2.0.0",
    "preact": ">=10.20.0",
    "preact-iso": ">=2.0.0",
    "react": ">=18.0.0",
    "vitepress": ">=1.0.0",
    "vue": ">=3.0.0"
  },
