{
  "name": "@swifty.js/anti-copy",
  "version": "0.0.1",
  "description": "Copy-protection SDK for browsers",
  "license": "MIT",
  "author": "https://github.com/hangtiancheng",
  "repository": {
    "type": "git",
    "url": "https://github.com/hangtiancheng/h.git",
    "directory": "packages/anti-copy"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/core/index.cjs",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./vitepress": {
      "types": "./dist/vitepress/index.d.ts",
      "import": "./dist/vitepress/index.js",
      "require": "./dist/vitepress/index.cjs"
    },
    "./swifty-docs": {
      "types": "./dist/docs/swifty.d.ts",
      "import": "./dist/docs/swifty.js",
      "require": "./dist/docs/swifty.cjs"
    },
    "./lark-docs": {
      "types": "./dist/docs/lark.d.ts",
      "import": "./dist/docs/lark.js",
      "require": "./dist/docs/lark.cjs"
    },
    "./rspress": {
      "types": "./dist/rspress/index.d.ts",
      "import": "./dist/rspress/index.js",
      "require": "./dist/rspress/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rollup -c ./rollup.config.js",
    "test": "vitest run",
    "format": "oxfmt --write ./",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.61.0",
    "rollup": "^4.62.3",
    "rollup-plugin-dts": "^6.4.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@lark.js/docs": ">=0.0.13",
    "@rspress/core": ">=2.0.0",
    "preact": ">=10.20.0",
    "preact-iso": ">=2.0.0",
    "react": ">=18.0.0",
    "vitepress": ">=1.0.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@rspress/core": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "preact-iso": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@lark.js/docs": {
      "optional": true
    },
    "vitepress": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
