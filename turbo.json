{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["build:chunk", "build:go"],
      "outputs": [".next/**", "!.next/cache/**", "out/**"]
    },
    "build:chunk": {
      "inputs": [
        "tsconfig.json",
        "tsconfig.build.json",
        "chucks/**/*.ts",
        "chucks/**/*.js"
      ],
      "outputs": ["dist/**"]
    },
    "build:go": {
      "inputs": ["go.mod", "go.sum", "chucks/**/*.go"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "outputs": []
    },
    "typecheck:chunk": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "cache": false,
      "outputs": []
    }
  }
}
