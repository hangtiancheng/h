{
  "name": "wanproxy-js",
  "version": "0.0.1",
  "description": "TypeScript migration of WANProxy core components.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wanproxy": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "dist-rollup",
    "dist-tsup"
  ],
  "scripts": {
    "scriptc": "scriptc build ./src/index.ts -o ./build/wanproxy",
    "build": "tsc -p tsconfig.build.json",
    "build:rollup": "rollup -c ./rollup.config.ts",
    "build:tsup": "tsup --config ./tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "wanproxy",
    "xcodec",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^4.1.11",
    "rollup": "^4.62.5",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
